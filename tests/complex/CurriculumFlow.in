define course INTRO_CS { set credits=4; set level=100; }
define course DATA_STRUCT { set credits=4; set level=200; set eligibility=REQ_INTRO; }
define course ALGORITHMS { set credits=4; set level=300; set eligibility=REQ_DS; }

define rule REQ_INTRO { require student.credits_completed >= 20; }
define rule REQ_DS { require student.credits_completed >= 40; }

define workflow CS_DEGREE {
    stage "Year 1" { set max_credits=22; }
    stage "Year 2" { set max_credits=22; }
}

// Estudiante que apenas cumple requisitos
simulate "Estudiante Justo" using CS_DEGREE {
    for student {
        set id="uStudentOk";
        set credits_completed=40;
    }
    attempt enroll in [INTRO_CS, DATA_STRUCT, ALGORITHMS];
    // ALGORITHMS requiere 40 -> OK
}

// Estudiante que falla por poco
simulate "Estudiante Falla" using CS_DEGREE {
    for student {
        set id="uStudentFail";
        set credits_completed=39;
    }
    attempt enroll in [INTRO_CS, ALGORITHMS];
    // ALGORITHMS requiere 40 -> FAIL
    // INTRO requiere 20 -> OK
}
