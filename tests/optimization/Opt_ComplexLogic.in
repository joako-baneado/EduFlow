define course BASIC_PROG { set credits=4; set level=100; }
define course ADV_ALGO { set credits=4; set level=400; set eligibility=RULE_COMPLEX; }

// Regla compleja
define rule RULE_COMPLEX {
    require (student.credits_completed > 100 OR student.credits_completed > 200) AND student.credits_completed < 50;
}

define workflow LOGIC_FLOW {
    stage "Unique Stage" {
        set max_credits=20;
    }
}

simulate "Test Logic Fail" using LOGIC_FLOW {
    for student {
        set id="uLogicTest";
        set credits_completed=150;
    }
    attempt enroll in [ADV_ALGO];
}
