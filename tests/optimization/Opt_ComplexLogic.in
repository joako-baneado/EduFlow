course BASIC_PROG credits=4 level=100
course ADV_ALGO credits=4 level=400 eligibility=RULE_COMPLEX

# Regla compleja: (creds > 100 OR creds > 200) AND creds < 50
# Si creds es 150: (True OR False) AND False -> True AND False -> False.
# LLVM podria simplificar el grafo.
rule RULE_COMPLEX check (student.credits_completed > 100 OR student.credits_completed > 200) AND student.credits_completed < 50

workflow LOGIC_FLOW {
    stage "Unique Stage" {
        max_credits=20
    }
}

simulation "Test Logic Fail" using LOGIC_FLOW {
    student {
        id="uLogicTest"
        credits_completed=150
    }
    enroll [ADV_ALGO]
}
