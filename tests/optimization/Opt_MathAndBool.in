define course MATH101 { set credits=4; set level=100; }
define course PHYS101 { set credits=4; set level=100; }

define rule CHECK_MATH { 
    require student.credits_completed > 70; 
}

define rule CHECK_BOOL { 
    require student.credits_completed > 50 AND student.credits_completed < 100; 
}

define workflow OPTIMIZATION_FLOW {
    stage "Stage 1" {
        set max_credits=20;
    }
}

simulate "Simulacion Optimizacion Constante" using OPTIMIZATION_FLOW {
    for student {
        set id="u2021_MATH_FAIL";
        set credits_completed=60; 
        # 60 > 70 es False. MATH101 debería fallar.
    }
    attempt enroll in [MATH101];
}

simulate "Simulacion Optimizacion Booleana" using OPTIMIZATION_FLOW {
    for student {
        set id="u2021_BOOL_PASS";
        set credits_completed=60;
        # 60 > 50 AND 60 < 100 -> True. PHYS101 debería pasar.
    }
    attempt enroll in [PHYS101];
}
